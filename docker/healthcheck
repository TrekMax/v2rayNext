#!/bin/bash
set -e
systemctl is-active --quiet v2ray.service
if systemctl is-enabled --quiet v2ray-subscription.service; then
    systemctl is-active --quiet v2ray-subscription.service
    # Missing credentials must be rejected by a live subscription gateway.
    [[ $(curl --silent --output /dev/null --write-out '%{http_code}' \
        --max-time 2 http://127.0.0.1:8787/sub) == 403 ]]
fi
