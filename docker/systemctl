#!/bin/bash
# Service manager adapter for containers without systemd.
# Only these two services are managed by this container.
scripts=${V2RAY_SCRIPT_DIR:-${V2RAY_ROOT:-/etc/v2ray}/sh}
case $1 in
daemon-reload | list-units) exit 0 ;;
esac
for service_arg in "${@:2}"; do
    case $service_arg in
    v2ray-subscription | v2ray-subscription.service)
        exec /bin/bash "$scripts/docker/subscription-service" "$@"
        ;;
    v2ray | v2ray.service)
        exec /bin/bash "$scripts/docker/core-service" "$@"
        ;;
    esac
done
printf '%s\n' 'Unsupported container service' >&2
exit 1
